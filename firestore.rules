rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /studio_config/{configId} {
      // Allow read and write so that studio settings and projects sync in real-time across all devices
      allow read, write: if isValidId(configId);
    }
  }
}
